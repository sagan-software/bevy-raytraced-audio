+
+/// Rotating vertical walls preserve their height tangent; adding a horizontal plane invalidates it.
+#[test]
+fn rotating_walls_preserve_exact_reflections_across_scene_mutations() {
+    for phase in 0..8_u16 {
+        let mut scene = AcousticScene3d::default();
+        for i in 0..8_u16 {
+            let angle = f32::from(i + phase) * 0.13;
+            let x = 10. + f32::from(i);
+            let (s, c) = angle.sin_cos();
+            scene.add_triangle(
+                Triangle3d::try_new(
+                    [
+                        Point3::try_new(x - c, 2., -s).unwrap(),
+                        Point3::try_new(x - c, 4., -s).unwrap(),
+                        Point3::try_new(x + c, 4., s).unwrap(),
+                    ],
+                    AcousticMaterial::default(),
+                )
+                .unwrap(),
+            );
+        }
+        let acceleration = scene.acceleration();
+        for y in [-3., 0., 3., 6.] {
+            let source = vector(-1., y, -0.5);
+            let receiver = vector(-2., y + 0.25, 0.5);
+            let may_reflect = acceleration.hierarchy.may_have_reflections(Bounds::path_3d(
+                (source.x, source.y, source.z),
+                (receiver.x, receiver.y, receiver.z),
+            ));
+            if !may_reflect {
+                assert!(
+                    acceleration
+                        .triangles
+                        .iter()
+                        .all(|t| first_reflection(source, receiver, t).is_none())
+                );
+            }
+            if y == 0. {
+                assert!(!may_reflect);
+            }
+        }
+        let source = Emitter3d::new(Point3::try_new(-1., 0., -0.5).unwrap());
+        let receiver = Listener3d::new(Point3::try_new(-2., 0., 0.5).unwrap());
+        assert_eq!(scene.reflection_paths(source, receiver).count(), 0);
+        scene.add_triangle(
+            Triangle3d::try_new(
+                [
+                    Point3::try_new(-4., 6., -4.).unwrap(),
+                    Point3::try_new(4., 6., -4.).unwrap(),
+                    Point3::try_new(0., 6., 4.).unwrap(),
+                ],
+                AcousticMaterial::default(),
+            )
+            .unwrap(),
+        );
+        assert!(scene.reflection_paths(source, receiver).count() > 0);
+    }
+}
