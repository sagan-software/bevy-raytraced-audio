+/// Exact zero normal coordinates permit conservative projection rejection for tilted groups.
+#[test]
+fn exact_common_tangents_reject_only_impossible_projections() {
+    let build = || {
+        BoundingVolumeHierarchy::build(
+            (0..8).map(|i| (i, Bounds::path_3d((-1., -1., -1.), (1., 1., 1.)))),
+            SceneDimensions::Three,
+        )
+    };
+    for (axis, normal) in [(0, (0., 1., 1.)), (1, (1., 0., 1.)), (2, (1., 1., 0.))] {
+        let tree = build().with_reflection_normals([normal; 8]);
+        assert!(
+            !tree.may_have_reflections(Bounds::path_3d((100., 100., 100.), (101., 101., 101.)))
+        );
+        let mut point = [100.; 3];
+        point[axis] = 0.;
+        assert!(tree.may_have_reflections(Bounds::path_3d(
+            (point[0], point[1], point[2]),
+            (point[0], point[1], point[2])
+        )));
+    }
+    // Near-zero normals do not justify this exact conservative rejection.
+    let tree = build().with_reflection_normals([(1., f64::EPSILON, 1.); 8]);
+    assert!(tree.may_have_reflections(Bounds::path_3d((100., 100., 100.), (101., 101., 101.))));
+    let tree = build().with_reflection_normals([(1., 1., 1.)].into_iter().chain(
+        core::iter::once_with(|| panic!("no common tangent remains")),
+    ));
+    assert!(tree.may_have_reflections(Bounds::path_3d((100., 100., 100.), (101., 101., 101.))));
+}
