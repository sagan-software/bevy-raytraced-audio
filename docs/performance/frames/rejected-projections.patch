+/// Tangent rejection preserves endpoint tolerances and the unpruned scalar oracle at every scale.
+#[test]
+fn tangent_rejection_matches_unpruned_reflections() {
+    let start = point(0., 0.);
+    let end = point(1., 0.);
+    for (a, b) in [
+        (-3., -2.),
+        (2., 3.),
+        (-2., 3.),
+        (-0.5 * PARAMETER_EPSILON, -0.5 * PARAMETER_EPSILON),
+        (1. + 0.5 * PARAMETER_EPSILON, 1. + 0.5 * PARAMETER_EPSILON),
+    ] {
+        let source = point(a, 1.);
+        let receiver = point(b, 2.);
+        assert_eq!(
+            first_reflection(source, receiver, start, end),
+            reference_first_reflection(source, receiver, start, end)
+        );
+    }
+    let mut rng = crate::ray_trace::TraceRng::new(792);
+    for scale in [1.0e-30, 1.0e-10, 1., 1.0e10, 1.0e30] {
+        for _ in 0..1024 {
+            let mut vector = || Vector2 {
+                x: (rng.next_unit() * 20. - 10.) * scale,
+                y: (rng.next_unit() * 20. - 10.) * scale,
+            };
+            let source = vector();
+            let receiver = vector();
+            let start = vector();
+            let end = vector();
+            assert_eq!(
+                first_reflection(source, receiver, start, end),
+                reference_first_reflection(source, receiver, start, end)
+            );
+        }
+    }
+}
