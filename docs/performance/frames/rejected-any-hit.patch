+    /// Finds any exact blocker without sorting candidates by distance.
+    /// Transmission accumulation retains the ordered traversal above; boolean visibility
+    /// can stop before even testing the other child's bounds once a blocker is found.
+    pub(crate) fn any_segment_hit(
+        &self,
+        ray: Ray,
+        bounds: Bounds,
+        skipped_surface: Option<usize>,
+        mut intersects: impl FnMut(usize) -> bool,
+    ) -> bool {
+        if self.surface_indices.len() <= MAX_LEAF_SURFACES {
+            return !self
+                .visit_candidates_until(bounds, skipped_surface, |index| !intersects(index));
+        }
+        self.any_ray_hit(ray, 1.0, skipped_surface, intersects)
+    }
+
+    /// Finds a blocker along a bounded ray without ordering children by distance.
+    pub(crate) fn any_ray_hit(
+        &self,
+        ray: Ray,
+        maximum_parameter: f64,
+        skipped_surface: Option<usize>,
+        mut intersects: impl FnMut(usize) -> bool,
+    ) -> bool {
+        self.root.is_some_and(|root| {
+            self.any_segment_node(
+                root,
+                ray,
+                maximum_parameter,
+                skipped_surface,
+                &mut intersects,
+            )
+        })
+    }
+
+    /// Visits one node lazily; boolean queries need neither a closest distance nor child sorting.
+    fn any_segment_node(
+        &self,
+        index: usize,
+        ray: Ray,
+        maximum_parameter: f64,
+        skipped_surface: Option<usize>,
+        intersects: &mut impl FnMut(usize) -> bool,
+    ) -> bool {
+        let Some(node) = self.nodes.get(index) else {
+            return false;
+        };
+        if node.bounds.ray_entry(ray, maximum_parameter).is_none() {
+            return false;
+        }
+        match &node.kind {
+            NodeKind::Leaf { indices } => {
+                self.surface_indices
+                    .get(indices.clone())
+                    .is_some_and(|indices| {
+                        indices
+                            .iter()
+                            .any(|&surface| skipped_surface != Some(surface) && intersects(surface))
+                    })
+            }
+            NodeKind::Branch { left, right } => {
+                self.any_segment_node(*left, ray, maximum_parameter, skipped_surface, intersects)
+                    || self.any_segment_node(
+                        *right,
+                        ray,
+                        maximum_parameter,
+                        skipped_surface,
+                        intersects,
+                    )
+            }
+        }
+    }
