+/// Any-hit visibility agrees with ordered traversal in both directions and with skipped surfaces.
+#[test]
+fn any_hit_matches_ordered_visibility() {
+    for dimensions in [SceneDimensions::Two, SceneDimensions::Three] {
+        for count in [0, 1, 4, 5, 127] {
+            let surfaces: Vec<_> = (0..count).map(|i| planar_bounds(fixture_x(i))).collect();
+            let hierarchy =
+                BoundingVolumeHierarchy::build(surfaces.iter().copied().enumerate(), dimensions);
+            let bounds = Bounds::path_2d((-1., 0.), (200., 0.));
+            for (origin, direction) in [
+                ((-1., 0., 0.), (201., 0., 0.)),
+                ((200., 0., 0.), (-201., 0., 0.)),
+                ((-1., 2., 0.), (201., 0., 0.)),
+            ] {
+                let ray = super::Ray::new(origin, direction);
+                for selected in [0, count / 2, count.saturating_sub(1), usize::MAX] {
+                    for skip in [None, Some(selected)] {
+                        let hit = |i: usize| {
+                            i == selected
+                                && surfaces
+                                    .get(i)
+                                    .is_some_and(|b| b.ray_entry(ray, 1.).is_some())
+                        };
+                        let expected =
+                            !hierarchy.visit_segment_candidates(ray, bounds, skip, |i| !hit(i));
+                        assert_eq!(hierarchy.any_segment_hit(ray, bounds, skip, hit), expected);
+                        for limit in [0.0, 0.1, 0.5, 1.0, 2.0] {
+                            let reached = |i: usize| {
+                                i == selected
+                                    && surfaces.get(i).is_some_and(|b| b.ray_entry(ray, limit).is_some())
+                            };
+                            let linear = (0..count).any(|i| skip != Some(i) && reached(i));
+                            assert_eq!(hierarchy.any_ray_hit(ray, limit, skip, reached), linear);
+                        }
+                    }
+                }
+            }
+            if count > 4 {
+                let ray = super::Ray::new((-1., 0., 0.), (201., 0., 0.));
+                let mut calls = 0;
+                assert!(hierarchy.any_segment_hit(ray, bounds, None, |_| {
+                    calls += 1;
+                    true
+                }));
+                assert_eq!(calls, 1);
+                let mut broken = hierarchy.clone();
+                broken.root = None;
+                assert!(!broken.any_segment_hit(ray, bounds, None, |_| panic!("missing root")));
+                assert!(
+                    !hierarchy.any_segment_node(usize::MAX, ray, 1.0, None, &mut |_| panic!(
+                        "missing node"
+                    ))
+                );
+                broken.root = hierarchy.root;
+                broken.surface_indices.clear();
+                assert!(!broken.any_segment_node(
+                    broken.root.unwrap(),
+                    ray,
+                    1.0,
+                    None,
+                    &mut |_| panic!("missing indices")
+                ));
+            }
+        }
+    }
+}
